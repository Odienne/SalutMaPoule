{
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "db:up": "dotenv -e .env.dev -- dbmate up",
    "db:up:prod": "dotenv -e .env -- dbmate up",
    "db:up:test": "dotenv -e .env.test -- dbmate up",
    "db:down": "dotenv -e .env.dev -- dbmate down",
    "db:down:prod": "dotenv -e .env -- dbmate down",
    "db:down:test": "dotenv -e .env.test -- dbmate down",
    "db:rollback": "dotenv -e .env.dev -- dbmate rollback",
    "db:rollback:prod": "dotenv -e .env -- dbmate rollback",
    "db:rollback:test": "dotenv -e .env.test -- dbmate rollback",
    "db:generate": "dotenv -e .env.dev -- zapatos",
    "db:generate:prod": "dotenv -e .env -- zapatos",
    "db:generate:test": "dotenv -e .env.test -- zapatos",
    "test": "vitest"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/swagger": "^9.7.0",
    "@prisma/client": "^7.8.0",
    "@types/node": "^26.0.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "pg": "^8.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "zapatos": "^6.6.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.20.0",
    "dbmate": "^2.33.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
